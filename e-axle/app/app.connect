title: E-AXLE
window_title: null
logo_path: null
timeline:
  show: false
  display: relative
  pixels_per_tick: 0.0
  milestones: []
streaming:
  buffer_size: 5000
  timeline: null
  playback_speed: null
  window: null
  persistence:
  - enabled: 'true'
    data_source_rid: null
    file_path: null
    streams: []
  channels:
  - channel: stand.dut.current
  - channel: stand.dut.speed
  - channel: stand.dut.temperature
  - channel: stand.dut.torque
  - channel: stand.dut.velocity
  - channel: stand.left.current
  - channel: stand.left.speed
  - channel: stand.left.temperature
  - channel: stand.left.torque
  - channel: stand.left.velocity
  - channel: stand.right.current
  - channel: stand.right.speed
  - channel: stand.right.temperature
  - channel: stand.right.torque
  - channel: stand.right.velocity
  - channel: stand.sink.current
  - channel: stand.sink.voltage
  - channel: stand.source.current
  - channel: stand.source.ocp_limit
  - channel: stand.source.ovp_limit
  - channel: stand.source.voltage
  - channel: stand_state.state
python:
  packages:
  - e-axle
  wheelhouse: wheels
on_load: null
on_unload: null
tiles:
- layout: tabs
  tabs:
  - title: CONTROL
    allow_popout: true
    tile:
      layout: grid
      rows:
      - height: null
        columns:
        - width: null
          tile:
            layout: grid
            rows:
            - height: 0.40086457
              columns:
              - width: 0.17243129
                tile:
                  layout: pane
                  id: 11a0a371-8911-4e06-ace0-3da5edfa06ae
                  title: LEFT MOTOR CONTROL
                  direction: vertical
                  should_fill: true
                  elements:
                  - spacing: normal
                    inputs:
                    - input: dropdown
                      id: left-mode
                      label: Control Mode
                      options:
                      - Torque
                      - Current
                      - Velocity
                      default: Torque
                    - input: number
                      id: left-torque
                      label: Torque
                      default: 0.0
                      units: Nm
                    - input: number
                      id: left-current
                      label: Current
                      default: 0.0
                      min: -20.0
                      max: 20.0
                      stepper:
                        amount: 1.0
                      units: A
                    - input: number
                      id: left-velocity
                      label: Velocity
                      default: 0.0
                      units: RPM
              - width: 0.17243129
                tile:
                  layout: pane
                  id: 8d14973f-c099-406b-849d-bbe29e8c8eaa
                  title: RIGHT MOTOR CONTROL
                  direction: vertical
                  should_fill: true
                  elements:
                  - spacing: normal
                    inputs:
                    - input: dropdown
                      id: right-mode
                      label: Control Mode
                      options:
                      - Torque
                      - Current
                      - Velocity
                      default: Torque
                    - input: number
                      id: right-torque
                      label: Torque
                      default: 0.0
                      units: Nm
                    - input: number
                      id: right-current
                      label: Current
                      default: 0.0
                      min: -20.0
                      max: 20.0
                      stepper:
                        amount: 1.0
                      units: A
                    - input: number
                      id: right-velocity
                      label: Velocity
                      default: 0.0
                      units: RPM
            - height: 0.5531931
              columns:
              - width: null
                tile:
                  layout: pane
                  id: 86254d0d-a024-4f13-8e0b-8c2bf8347d49
                  title: DUT
                  direction: vertical
                  should_fill: true
                  elements:
                  - spacing: normal
                    inputs:
                    - input: dropdown
                      id: dut-mode
                      label: Control Mode
                      options:
                      - Torque
                      - Current
                      - Velocity
                      default: Torque
                    - input: number
                      id: dut-torque
                      label: Torque
                      default: 0.0
                      units: Nm
                    - input: number
                      id: dut-current
                      label: Current
                      default: 0.0
                      min: -20.0
                      max: 20.0
                      stepper:
                        amount: 1.0
                      units: A
                    - input: number
                      id: dut-velocity
                      label: Velocity
                      default: 0.0
                      units: RPM
                    - display: separator
                    - input: dropdown
                      id: stand-state
                      label: Requested State
                      options:
                      - Disarmed
                      - Armed
                      - Running
                      default: Disarmed
            - height: 0.36421406
              columns:
              - width: null
                tile:
                  layout: pane
                  id: 2bd33943-0353-4cd3-83cd-47c40aa217fa
                  title: Script Controls
                  direction: vertical
                  should_fill: true
                  elements:
                  - controls: script_table
                    scripts:
                    - label: Stand Control
                      path: stand_control.py
                      args: []
                      max_log_lines: 10000
                      id: control
                    show_output_column: true
            - height: 1.0181961
              columns:
              - width: null
                tile:
                  layout: pane
                  id: 74e44223-f2b1-4b10-a2ba-482c157c6c6a
                  title: Logs
                  direction: vertical
                  should_fill: true
                  elements:
                  - display: logs
                    script_id: control
        - width: null
          tile:
            layout: pane
            id: 6a508a3e-c7ff-4bf0-aa5c-ffcd238b3a48
            title: Line Plot
            direction: vertical
            should_fill: true
            elements:
            - plot: line
              stream_id: stand
              colors: []
              legend_placement: bottom_left
              x_format: timestamp
              x_time_display: Local
              x_scale: linear
              y_scale: linear
              time_window: 30s
left_panel: null
right_panel: null
bottom_panel: null
scene: {}
poster: null
prompt_windows: []
mcap_path: null
conditionals: []
